{
	"defaults": {
		"changelog_version_title": "v{{version}} — qzwdv release",
		"include_private": false,
		"package_type": "python",
		"parent_bump": "minor",
		"release_title": "qzwdv release",
		"strict_version_conflicts": true,
		"warn_on_group_mismatch": false
	},
	"ecosystems": {
		"cargo": {
			"enabled": true,
			"publish": {
				"enabled": true
			},
			"roots": [
				"crates/cargo"
			]
		}
	},
	"group": {
		"main": {
			"packages": [
				"qzwdv_0",
				"qzwdv_1"
			],
			"release": true,
			"tag": true,
			"version_format": "namespaced"
		}
	},
	"lints": {
		"rules": {
			"no-unnecessary-releases": "error"
		},
		"scopes": [
			"crates/qzwdv"
		],
		"use": [
			"no-unnecessary-releases"
		]
	},
	"package": {
		"qzwdv_0": {
			"path": "crates/qzwdv_0",
			"release": true,
			"tag": true,
			"type": "python",
			"version_format": "namespaced"
		},
		"qzwdv_1": {
			"path": "crates/qzwdv_1",
			"release": false,
			"tag": false,
			"type": "python",
			"version_format": "namespaced"
		},
		"qzwdv_2": {
			"path": "crates/qzwdv_2",
			"release": false,
			"tag": false,
			"type": "python",
			"version_format": "namespaced"
		},
		"qzwdv_3": {
			"path": "crates/qzwdv_3",
			"release": false,
			"tag": false,
			"type": "python",
			"version_format": "namespaced"
		}
	},
	"source": {
		"host": "github.example.com",
		"owner": "qzwdv",
		"provider": "github",
		"pull_requests": {
			"auto_merge": false,
			"base": "main",
			"branch_prefix": "qzwdv/release",
			"enabled": true,
			"labels": [
				"release",
				"automated"
			],
			"title": "chore(release): prepare qzwdv release",
			"verified_commits": false
		},
		"repo": "pbh"
	}
}
