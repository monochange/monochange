{
	"changelog": {
		"sections": {
			"bug-fixes": {
				"description": "Resolved defects",
				"heading": "🐛 Bug Fixes",
				"priority": 10
			},
			"features": {
				"description": "New capabilities",
				"heading": "✨ Features",
				"priority": 20
			}
		},
		"style": {
			"collapsed_section_style": "plain",
			"metadata_style": "blockquote",
			"package_label_style": "badge",
			"section_separator": "thematic_break"
		},
		"types": {
			"feature": {
				"bump": "minor",
				"description": "New features",
				"section": "features"
			},
			"fix": {
				"bump": "patch",
				"description": "Bug fixes",
				"section": "bug-fixes"
			}
		}
	},
	"defaults": {
		"changelog_version_title": "v{{version}} — voa release",
		"empty_update_message": "No significant changes for voa packages.",
		"include_private": true,
		"package_type": "deno",
		"parent_bump": "none",
		"strict_version_conflicts": false,
		"warn_on_group_mismatch": false
	},
	"ecosystems": {
		"cargo": {
			"enabled": true,
			"publish": {
				"enabled": true
			},
			"roots": [
				"crates/cargo"
			]
		}
	},
	"lints": {
		"rules": {
			"no-unnecessary-releases": "error"
		},
		"scopes": [
			"crates/voa"
		],
		"use": [
			"no-unnecessary-releases"
		]
	},
	"package": {
		"voa_0": {
			"path": "crates/voa_0",
			"release": true,
			"tag": true,
			"type": "deno",
			"version_format": "namespaced"
		},
		"voa_1": {
			"path": "crates/voa_1",
			"release": false,
			"tag": false,
			"type": "deno",
			"version_format": "namespaced"
		},
		"voa_2": {
			"path": "crates/voa_2",
			"release": false,
			"tag": false,
			"type": "deno",
			"version_format": "namespaced"
		}
	},
	"source": {
		"api_url": "api.github.example.com",
		"host": "github.example.com",
		"owner": "voa",
		"provider": "github",
		"pull_requests": {
			"auto_merge": true,
			"base": "main",
			"branch_prefix": "voa/release",
			"enabled": true,
			"labels": [
				"release",
				"automated"
			],
			"title": "chore(release): prepare voa release",
			"verified_commits": false
		},
		"repo": "gmuf"
	}
}
