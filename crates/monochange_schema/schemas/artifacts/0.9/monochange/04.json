{
	"changesets": {
		"affected": {
			"changed_paths": [
				"crates/lqchacyd/"
			],
			"comment_on_failure": true,
			"enabled": true,
			"ignored_paths": [
				"**/*.md"
			],
			"required": true,
			"skip_labels": [
				"skip-changeset"
			]
		}
	},
	"defaults": {
		"changelog_version_title": "v{{version}} — lqchacyd release",
		"empty_update_message": "No significant changes for lqchacyd packages.",
		"include_private": false,
		"package_type": "python",
		"parent_bump": "major",
		"release_title": "lqchacyd release",
		"strict_version_conflicts": false,
		"warn_on_group_mismatch": false
	},
	"package": {
		"lqchacyd_0": {
			"path": "crates/lqchacyd_0",
			"release": true,
