{
	"changelog": {
		"sections": {
			"bug-fixes": {
				"description": "Resolved defects",
				"heading": "🐛 Bug Fixes",
				"priority": 10
			},
			"features": {
				"description": "New capabilities",
				"heading": "✨ Features",
				"priority": 20
			}
		},
		"style": {
			"collapsed_section_style": "details",
			"metadata_style": "blockquote",
			"package_label_style": "badge",
			"section_separator": "thematic_break"
		},
		"types": {
			"feature": {
				"bump": "minor",
				"description": "New features",
				"section": "features"
			},
			"fix": {
				"bump": "patch",
				"description": "Bug fixes",
				"section": "bug-fixes"
			}
		}
	},
	"defaults": {
		"include_private": true,
		"package_type": "cargo",
		"parent_bump": "none",
		"strict_version_conflicts": true,
		"warn_on_group_mismatch": false
	},
	"package": {
		"qthg_0": {
			"path": "crates/qthg_0",
			"release": true,
			"tag": true,
			"type": "cargo",
			"version_format": "namespaced"
		},
		"qthg_1": {
			"path": "crates/qthg_1",
			"release": false,
			"tag": false,
			"type": "cargo",
			"version_format": "namespaced"
		},
		"qthg_2": {
			"path": "crates/qthg_2",
			"release": false,
			"tag": false,
			"type": "cargo",
			"version_format": "namespaced"
		},
		"qthg_3": {
			"path": "crates/qthg_3",
			"release": false,
			"tag": false,
			"type": "cargo",
			"version_format": "namespaced"
		}
	},
	"source": {
		"api_url": "api.forgejo.example.com",
		"host": "forgejo.example.com",
		"owner": "qthg",
		"provider": "forgejo",
		"pull_requests": {
			"auto_merge": false,
			"base": "main",
			"branch_prefix": "qthg/release",
			"enabled": true,
			"labels": [
				"release",
				"automated"
			],
			"title": "chore(release): prepare qthg release",
			"verified_commits": false
		},
		"repo": "igl"
	}
}
