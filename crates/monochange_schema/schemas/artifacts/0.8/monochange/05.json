{
	"defaults": {
		"changelog_version_title": "v{{version}} — tce release",
		"include_private": true,
		"package_type": "deno",
		"parent_bump": "major",
		"release_title": "tce release",
		"strict_version_conflicts": true,
		"warn_on_group_mismatch": false
	},
	"lints": {
		"rules": {
			"no-unnecessary-releases": "error"
		},
		"scopes": [
			"crates/tce"
		],
		"use": [
			"no-unnecessary-releases"
		]
	},
	"package": {
		"tce_0": {
			"path": "crates/tce_0",
			"release": true,
			"tag": true,
			"type": "deno",
			"version_format": "namespaced"
		},
		"tce_1": {
			"path": "crates/tce_1",
			"release": false,
			"tag": false,
			"type": "deno",
			"version_format": "namespaced"
		},
		"tce_2": {
			"path": "crates/tce_2",
			"release": false,
			"tag": false,
			"type": "deno",
			"version_format": "namespaced"
		},
		"tce_3": {
			"path": "crates/tce_3",
			"release": false,
			"tag": false,
			"type": "deno",
			"version_format": "namespaced"
		},
		"tce_4": {
			"path": "crates/tce_4",
			"release": false,
			"tag": false,
			"type": "deno",
			"version_format": "namespaced"
		}
	},
	"source": {
		"api_url": "api.gitlab.example.com",
		"host": "gitlab.example.com",
		"owner": "tce",
		"provider": "gitlab",
		"pull_requests": {
			"auto_merge": true,
			"base": "main",
			"branch_prefix": "tce/release",
			"enabled": true,
			"labels": [
				"release",
				"automated"
			],
			"title": "chore(release): prepare tce release",
			"verified_commits": false
		},
		"repo": "uykogkell"
	}
}
