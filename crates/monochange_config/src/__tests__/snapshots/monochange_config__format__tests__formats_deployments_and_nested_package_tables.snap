---
source: crates/monochange_config/src/__tests__/format_tests.rs
expression: format_workspace_configuration(source).unwrap()
---
[defaults]
parent_bump = "patch"

[package.web]
path = "packages/web"

[package.web.publish]
enabled = false

[[package.web.deployments]]
name = "nested"

[[deployments]]
name = "docs"
trigger = "release_published"

[[deployments]]
name = "app"
trigger = "workflow"
