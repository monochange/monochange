---
source: crates/monochange_integration_tests/tests/schema_assets.rs
expression: inventory
---
{
  "configuration": {
    "additionalProperties": false,
    "dynamicTables": [
      "package",
      "group",
      "cli"
    ],
    "schemaId": "https://monochange.github.io/monochange/schemas/monochange.schema.json"
  },
  "current_schema_version": "[schema version]",
  "releaseRecord": {
    "additionalProperties": false,
    "kind": "monochange.releaseRecord",
    "required": [
      "created_at",
      "command",
      "release_targets",
      "released_packages",
      "changed_files"
    ],
    "schemaId": "https://monochange.github.io/monochange/schemas/release-record.schema.json"
  },
  "schemaCrateVersion": "[schema crate version]"
}
