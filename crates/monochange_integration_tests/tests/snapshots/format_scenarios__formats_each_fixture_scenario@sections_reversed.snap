---
[defaults]
package_type = "npm"

[changelog]
templates = ["- {{ summary }}"]

[package.alpha]
path = "packages/alpha"

[package.zeta]
path = "packages/zeta"

[group.main]
packages = ["alpha", "zeta"]

[source]
provider = "github"
owner = "acme"
repo = "widgets"

[cli.release]
help_text = "Release"
