---
source: crates/monochange_integration_tests/tests/format_scenarios.rs
expression: formatted
---
[defaults]
package_type = "npm"

[package.alpha]
path = "packages/alpha"

[package.beta]
path = "packages/beta"

[group.main]
packages = ["alpha", "beta"]

[lints]
use = []

[ecosystems.npm]
enabled = true

[prerelease]
enabled = false

[changesets.affected]
required = false

[cli.deploy]
help_text = "Deploy"
steps = [{ type = "Validate" }]
