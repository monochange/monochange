---
source: crates/monochange_integration_tests/tests/npm_quoted_pnpm_lock.rs
expression: lockfile
---
lockfileVersion: '9.0'

settings:
  autoInstallPeers: true
  excludeLinksFromLockfile: false

importers:
  .:
    dependencies:
      '@acme/api': 2.4.0

  packages/consumer:
    dependencies:
      '@acme/api':
        specifier: ^2.3.1
        version: 2.4.0

  packages/linked-consumer:
    dependencies:
      '@acme/api': 'link:../api'

  packages/workspace-consumer:
    dependencies:
      '@acme/api': 'workspace:*'
