		"@monochange/cli-linux-arm64-gnu": "^0.9.1",
		"@monochange/cli-linux-arm64-musl": "^0.9.1",
		"@monochange/cli-linux-x64-gnu": "^0.9.1",
		"@monochange/cli-linux-x64-musl": "^0.9.1",
		"@monochange/cli-win32-arm64-msvc": "^0.9.1",
		"@monochange/cli-win32-x64-msvc": "^0.9.1"
	},
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"build": "pnpm --dir ../.. build",
