{
	"name": "@monochange/feedback-react-native",
	"version": "0.1.0",
	"type": "module",
	"description": "Native monochange feedback screens for React Native apps",
	"license": "Unlicense",
	"repository": "https://github.com/monochange/monochange",
	"files": ["dist", "README.md"],
