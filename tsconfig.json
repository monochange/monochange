{
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"allowJs": false,
		"jsx": "react-jsx",
		"checkJs": false,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"noEmit": true,
		"noImplicitAny": false,
		"skipLibCheck": true,
		"strict": false,
		"target": "ES2024",
		"types": [
			"node",
			"vitest/globals"
		],
		"paths": {
			"@monochange/feedback/client": [
				"./packages/monochange__feedback/src/client.ts"
			]
		}
	},
	"exclude": [
		"dist",
		"fixtures",
		"node_modules",
		"target"
	],
	"include": [
		"evals/monochange-skill/run.ts",
		"evals/monochange-skill/lib/**/*.ts",
		"scripts/**/*.ts",
		"packages/monochange__cli/src/**/*.ts",
		"packages/monochange__feedback/src/**/*.ts",
		"packages/monochange__feedback-react-native/src/**/*.tsx"
	]
}
