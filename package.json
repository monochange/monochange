{
	"name": "@monochange/root",
	"private": true,
	"type": "module",
	"description": "Monorepo root for monochange npm packages",
	"license": "Unlicense",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/monochange/monochange.git"
	},
	"scripts": {
		"check": "tsgo -config tsconfig.json",
		"fmt": "oxfmt --write \"**/*.ts\"",
		"fmt:check": "oxfmt --check \"**/*.ts\"",
		"lint": "oxlint --type-aware .",
		"lint:syntax": "oxlint .",
		"build": "tsdown && pnpm build:feedback",
		"build:feedback": "node scripts/build-feedback.ts",
		"bench:website": "node scripts/benchmark-website.ts run",
		"size:website": "node scripts/website-size.ts check",
		"size:website:update": "node scripts/website-size.ts update"
	},
	"devDependencies": {
		"esbuild": "^0.28.2",
		"happy-dom": "^20.0.0",
		"@rslint/tsgo": "^0.5.0",
		"@types/node": "^24.10.1",
		"lighthouse": "^13.5.0",
		"oxfmt": "^0.46.0",
		"oxlint": "^1.61.0",
		"oxlint-tsgolint": "^0.22.0",
		"tsdown": "^0.21.10",
		"typescript": "^6.0.3",
		"vitest": "^4.1.5"
	},
	"engines": {
		"node": ">=24.0.0",
		"pnpm": ">=12"
	}
}
